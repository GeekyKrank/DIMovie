[Unit]
Description=DIMovie public nickname libraries
After=network-online.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 -I /opt/dimovie-library/library_api.py
StateDirectory=dimovie-library
StateDirectoryMode=0700
Restart=on-failure
MemoryMax=48M
CPUQuota=10%
TasksMax=12
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
